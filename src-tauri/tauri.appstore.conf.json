{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "features": ["store-channel"]
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "targets": ["app"],
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15",
      "entitlements": "./macos/Entitlements.store.plist",
      "signingIdentity": null,
      "files": {
        "embedded.provisionprofile": "macos/embedded.provisionprofile"
      }
    }
  }
}
