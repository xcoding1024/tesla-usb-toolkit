<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">
  <!--
    Optional self-packaged MSIX identity. Tauri 2 does not emit .msix.
    Partner Center "EXE or MSI app" submissions do not need this file.

    Replace before MakeAppx / winapp pack:
      Identity/@Name        Partner Center package identity name
      Identity/@Publisher   CN=... from Partner Center (never invent a certificate)
      PublisherDisplayName  Partner Center publisher display name
    Signing: leave unset here. Do not commit .pfx / .p12 files.
  -->
  <Identity
    Name="coding1024.USBToolkitforTesla"
    Publisher="CN=TODO-PARTNER-CENTER-PUBLISHER-ID"
    Version="0.2.0.0"
    ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>USB Toolkit for Tesla</DisplayName>
    <PublisherDisplayName>coding1024</PublisherDisplayName>
    <Description>Scan and format USB drives for Tesla vehicles.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="zh-cn" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
  <Applications>
    <Application Id="USBToolkitforTesla" Executable="USB Toolkit for Tesla.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="USB Toolkit for Tesla"
        Description="Scan and format USB drives for Tesla vehicles."
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
